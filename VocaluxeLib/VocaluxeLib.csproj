<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>VocaluxeLib</RootNamespace>
    <AssemblyName>VocaluxeLib</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Properties/AssemblyInfo.cs is kept from the original project -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The legacy code triggers many analyzer/obsolete warnings; do not fail the build on them during migration -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Same OS-conditional symbols as Vocaluxe.csproj: VocaluxeLib has #if WIN code (e.g. ERenderer's
         TR_CONFIG_DIRECT3D) that the game references, so the library must agree on the platform define.
         Target platform over build host, for the same reason as there. Note that a cross-publish builds
         this project without a RID, so here the host decides - which is right in every case that
         matters, since Windows is the only platform whose symbols actually differ. -->
    <_VocaluxeTargetsWindows Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</_VocaluxeTargetsWindows>
    <_VocaluxeTargetsWindows Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</_VocaluxeTargetsWindows>
    <_VocaluxeTargetsOSX Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('OSX'))</_VocaluxeTargetsOSX>
    <_VocaluxeTargetsOSX Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('osx'))</_VocaluxeTargetsOSX>
    <DefineConstants Condition="'$(_VocaluxeTargetsWindows)' == 'true'">WIN;ARCH_X64</DefineConstants>
    <DefineConstants Condition="'$(_VocaluxeTargetsWindows)' != 'true'">LINUX;ARCH_X64</DefineConstants>
    <DefineConstants Condition="'$(_VocaluxeTargetsOSX)' == 'true'">$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.TextWriter" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Log\CLogFunctions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CLogFunctions.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
